# ─────────────────────────────────────────────────────────────────────────────
# RideConnect Node.js Backend — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8081
LOG_LEVEL=info

# ── Firebase Configuration ───────────────────────────────────────────────────
FIREBASE_PROJECT_ID=ecoride-4d8a8
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=ecoride-4d8a8.firebaseapp.com
FIREBASE_STORAGE_BUCKET=ecoride-4d8a8.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=631849623028
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin Service Account (Optional / Production)
# Option A — Local dev: path to downloaded serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B — Docker / CI/CD: individual env vars (copy from Firebase console)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@ecoride-4d8a8.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── JWT (generate: openssl rand -hex 32) ──────────────────────────────────────
JWT_SECRET=replace_with_32+_char_random_secret
JWT_EXPIRATION=86400000

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── CORS (comma-separated origins, or * for dev only) ─────────────────────────
CORS_ORIGIN=https://your-frontend.com

# ── Nginx (docker-compose) ────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
