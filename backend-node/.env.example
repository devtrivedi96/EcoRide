# ─────────────────────────────────────────────────────────────────────────────
# RideConnect Node.js Backend — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8081
LOG_LEVEL=info

# ── Firebase (choose ONE option) ──────────────────────────────────────────────
# Option A — Local dev: path to downloaded serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B — Docker / CI/CD: individual env vars (copy from Firebase console)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── JWT (generate: openssl rand -hex 32) ──────────────────────────────────────
JWT_SECRET=replace_with_32+_char_random_secret
JWT_EXPIRATION=86400000

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── CORS (comma-separated origins, or * for dev only) ─────────────────────────
CORS_ORIGIN=https://your-frontend.com

# ── Nginx (docker-compose) ────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
